# sysext k3s: one static Go binary, everything else comes from the units.
# Version policy: ULAB_PINNED_VERSION when set (renovate target), otherwise
# the newest upstream release tag ("v1.36.5+k3s1" -> version 1.36.5+k3s1).

ULAB_SYSEXT_NAME=k3s
ULAB_SYSEXT_REPO=k3s-io/k3s
# renovate: packageName=k3s-io/k3s
ULAB_PINNED_VERSION=1.36.5+k3s1
