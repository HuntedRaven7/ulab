# sysext k0s: single static binary, defaulting to controller role; a node
# becomes a worker by writing /etc/default/k0s-worker (see k0s-worker).
# Version policy: ULAB_PINNED_VERSION when set, otherwise newest tag.

ULAB_SYSEXT_NAME=k0s
ULAB_SYSEXT_REPO=k0sproject/k0s
# renovate: packageName=k0sproject/k0s
ULAB_PINNED_VERSION=1.36.4+k0s.1
