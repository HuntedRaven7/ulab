# sysext kubestellar: the KubeStellar deployment tooling, not the control
# plane itself. Ships helm plus the release binaries (controller-manager,
# ocm-transport-controller, kflex-get-kubeconfig) so `ujust kubestellar`
# can run the upstream core chart onto a local k3s/k0s hosting cluster.
# Version policy: ULAB_PINNED_VERSION when set, otherwise newest tag.

ULAB_SYSEXT_NAME=kubestellar
ULAB_SYSEXT_REPO=kubestellar/kubestellar
# renovate: packageName=kubestellar/kubestellar
ULAB_PINNED_VERSION=0.30.0

# helm ships inside this sysext because it is the deployment vehicle for
# the core chart; keep it pinned separately.
# renovate: packageName=helm/helm
ULAB_HELM_VERSION=4.3.1
ULAB_HELM_SHA256=0403a88ae20913d11b10a2467b50087721fea7581736da6b9d3992f5357fe54b
