# KubeStellar deployment defaults, consumed by ujust kubestellar.
# Override any of these with /etc/kubestellar/env (the recipe sources it
# after this file unless it exists, in which case only it is sourced).

KUBESTELLAR_CHART=oci://ghcr.io/kubestellar/kubestellar/core-chart
KUBESTELLAR_VERSION=0.30.0
# Default hosting-cluster control planes the core chart creates on install.
# Customize with --set-json on the ujust command line instead of editing.
KUBESTELLAR_ITSES='[{"name":"its1"}]'
KUBESTELLAR_WDSES='[{"name":"wds1"}]'

# NOTE: k3s/k0s hosting clusters need ingress with SSL passthrough mapped
# to host port 9443 for KubeFlex-hosted control planes of type "vcluster";
# with the default localtest.me domain this works out of the box for
# single-machine deployments (kubestellar.io core-helm-chart).
